# Comma-separated list of allowed frontend origins
FRONTEND_URL=http://localhost:5173

# Optional: regex to also allow Vercel preview deployments
# CORS_ORIGIN_REGEX=https://your-app-.*\.vercel\.app

# PayPal SANDBOX credentials (developer.paypal.com > Apps & Credentials > Sandbox).
# Sandbox only: the app never talks to live PayPal.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Share of the trip price charged up front, in percent
DEPOSIT_PCT=30
# Optional: SQLite file for bookings (default: OS temp dir, lost on restart)
# BOOKINGS_DB=/tmp/wayfare_bookings.sqlite3

# Gemini (Google AI Studio free key: aistudio.google.com/apikey). Optional: without it the advisor stays rule-based.
GEMINI_API_KEY=
# Change if Google retires the default model
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_TIMEOUT_S=8

# Aiven PostgreSQL (console > your service > Overview > Service URI). With it set, the seed data, imported
# inventory and PayPal bookings are stored in Aiven; without it the app serves the committed JSON and keeps
# bookings in a local SQLite file. Load the data once with: python scripts/load_to_sql.py --reset
# DATABASE_URL=postgres://avnadmin:PASSWORD@HOST:PORT/defaultdb?sslmode=require

# Optional: SQLite file for anomaly resolutions when DATABASE_URL is empty
# (default: OS temp dir, so decisions reset on restart on Render's free plan).
# With DATABASE_URL set they go to the Aiven table anomaly_resolution instead.
# ANOMALY_DB=/tmp/wayfare_anomalies.sqlite3

# Advisor limits (Phase G). All optional.
# Estimated Gemini spend ceiling per calendar month (USD). At the cap the advisor serves the rule-based plan. 0 = never call Gemini.
# LLM_MONTHLY_CAP=5
# Token prices used for the estimate (USD per million tokens). Check Google's current price list.
# LLM_PRICE_IN_PER_M=0.30
# LLM_PRICE_OUT_PER_M=2.50
# Requests per browser session per window, and the window in seconds
# ADVISOR_SESSION_LIMIT=20
# ADVISOR_SESSION_WINDOW_S=3600
# SQLite file for the monthly usage record when DATABASE_URL is empty
# LLM_USAGE_DB=/tmp/wayfare_llm_usage.sqlite3
# Pass mark for scripts/run_advisor_eval.py and CI (0 to 1)
# ADVISOR_EVAL_THRESHOLD=0.9
